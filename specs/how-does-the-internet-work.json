    {
      "id": "myth-not-gps",
      "section": "bridge",
      "purpose": "the-rerouting-myth: Correct the GPS-rerouting misconception.",
      "narration": "You might picture routers acting like a GPS, hunting for the fastest path for every packet. They don't. A router just looks up the destination in its table. The table changes only when neighbors announce changes, so the same destination usually gets the same route.",
      "claims": [
        "packets-can-reroute-on-change",
        "no-global-routing-map"
      ],
      "visual": {
