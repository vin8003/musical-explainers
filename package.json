{
  "name": "musical-explainers",
  "version": "0.1.0",
  "private": true,
  "description": "Code-driven musical explainer videos (Remotion)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "generate": "tsx scripts/generate.ts",
    "render": "remotion render src/index.ts Explainer out/video.mp4",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "admin": "node admin/server.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
